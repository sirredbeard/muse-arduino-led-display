<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- Muse.Gadget.Sdk.Linux lives on GitHub Packages, which needs auth even
         for public packages. Add your own credentials locally (never in this file) with:
         dotnet nuget add source https://nuget.pkg.github.com/sirredbeard/index.json
           -name sirredbeard-github -username <github-user>
           -password <classic-PAT-with-read:packages> -store-password-in-clear-text -->
    <add key="sirredbeard-github" value="https://nuget.pkg.github.com/sirredbeard/index.json" />
  </packageSources>
</configuration>
